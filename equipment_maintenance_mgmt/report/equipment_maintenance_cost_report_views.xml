<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Maintenance Cost Analysis ================= -->
    <!-- MAINTENANCE COST ANALYSIS views on the SQL-view model.
         PIVOT: type="row" / type="col" = default grouping (category x month),
         type="measure" = summed values, interval="month" groups dates by month. -->
    <record id="equipment_maintenance_cost_report_view_pivot" model="ir.ui.view">
        <field name="name">equipment.maintenance.cost.report.view.pivot</field>
        <field name="model">equipment.maintenance.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Cost Analysis" sample="1" disable_linking="0">
                <field name="category_id" type="row"/>
                <field name="request_date" interval="month" type="col"/>
                <field name="labour_cost" type="measure"/>
                <field name="spare_part_cost" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH: stacked bar chart of the total cost per month and category -->
    <record id="equipment_maintenance_cost_report_view_graph" model="ir.ui.view">
        <field name="name">equipment.maintenance.cost.report.view.graph</field>
        <field name="model">equipment.maintenance.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Cost Analysis" type="bar" stacked="1" sample="1">
                <field name="request_date" interval="month"/>
                <field name="category_id"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- LIST: detailed rows; create/edit/delete disabled (read-only report) -->
    <record id="equipment_maintenance_cost_report_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.cost.report.view.list</field>
        <field name="model">equipment.maintenance.cost.report</field>
        <field name="arch" type="xml">
            <list string="Maintenance Cost Analysis" create="0" edit="0" delete="0">
                <field name="request_id"/>
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="technician_id" widget="many2one_avatar_user"/>
                <field name="request_type"/>
                <field name="request_date"/>
                <field name="state" widget="badge"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_hours" sum="Total" widget="float_time"/>
                <field name="labour_cost" sum="Total"/>
                <field name="spare_part_cost" sum="Total"/>
                <field name="total_cost" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- SEARCH: filters and all available group-bys of the analysis -->
    <record id="equipment_maintenance_cost_report_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.cost.report.view.search</field>
        <field name="model">equipment.maintenance.cost.report</field>
        <field name="arch" type="xml">
            <search string="Maintenance Cost Analysis">
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <field name="technician_id"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="not_cancelled" string="Not Cancelled" domain="[('state', '!=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_request_date" string="Request Date" date="request_date"/>
                <group>
                    <filter name="group_by_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_by_technician" string="Technician" context="{'group_by': 'technician_id'}"/>
                    <filter name="group_by_type" string="Request Type" context="{'group_by': 'request_type'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action of Reporting > Maintenance Cost Analysis (pivot first, cancelled excluded) -->
    <record id="equipment_maintenance_cost_report_action" model="ir.actions.act_window">
        <field name="name">Maintenance Cost Analysis</field>
        <field name="res_model">equipment.maintenance.cost.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No maintenance cost data yet</p>
            <p>Costs are collected from the activities and spare parts of maintenance requests.</p>
        </field>
    </record>

    <!-- ================= Equipment Maintenance History ================= -->
    <!-- EQUIPMENT MAINTENANCE HISTORY: completed requests grouped by equipment -->
    <record id="equipment_maintenance_request_action_history" model="ir.actions.act_window">
        <field name="name">Equipment Maintenance History</field>
        <field name="res_model">equipment.maintenance.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="equipment_maintenance_request_view_list"/>
        <field name="context">{'search_default_group_by_equipment': 1, 'search_default_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No maintenance history yet</p>
            <p>Completed maintenance requests are listed here per equipment.
               Use "Print History" on an equipment to get a PDF.</p>
        </field>
    </record>
</odoo>
