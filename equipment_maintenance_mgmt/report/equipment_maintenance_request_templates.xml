<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWEB TEMPLATE of one work order (o = the printed request).
         web.external_layout adds the company header and footer.
         t-set: define a variable; with_context(lang=...): print in the user language. -->
    <template id="report_maintenance_request_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=o.env.user.lang)"/>
            <div class="page">
                <!-- t-field: display a field with its formatting (dates, monetary, selection label) -->
                <h2>
                    Maintenance Work Order <span t-field="o.name"/>
                </h2>
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <strong>Equipment:</strong> <span t-field="o.equipment_id"/><br/>
                        <strong>Category:</strong> <span t-field="o.category_id"/><br/>
                        <strong>Location:</strong> <span t-field="o.location_id"/><br/>
                        <strong>Responsible:</strong> <span t-field="o.employee_id"/>
                    </div>
                    <div class="col-6">
                        <strong>Request Date:</strong> <span t-field="o.request_date"/><br/>
                        <strong>Type:</strong> <span t-field="o.request_type"/><br/>
                        <strong>Priority:</strong> <span t-field="o.priority"/><br/>
                        <strong>Technician:</strong> <span t-field="o.technician_id"/><br/>
                        <strong>Status:</strong> <span t-field="o.state"/>
                    </div>
                </div>

                <div t-if="o.description" class="mb-3">
                    <h5>Description</h5>
                    <div t-field="o.description"/>
                </div>

                <h5>Maintenance Activities</h5>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Activity</th>
                            <th>Technician</th>
                            <th class="text-end">Hours</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- t-foreach / t-as: loop over the activity lines, one table row per line -->
                        <tr t-foreach="o.work_activity_ids" t-as="line">
                            <td><span t-field="line.date"/></td>
                            <td><span t-field="line.name"/></td>
                            <td><span t-field="line.technician_id"/></td>
                            <!-- t-options widget float_time: hours shown as HH:MM -->
                            <td class="text-end"><span t-field="line.hours_spent" t-options="{'widget': 'float_time'}"/></td>
                            <td class="text-end"><span t-field="line.labour_rate"/></td>
                            <td class="text-end"><span t-field="line.cost"/></td>
                        </tr>
                        <!-- t-if: row displayed only when there is no activity -->
                        <tr t-if="not o.work_activity_ids">
                            <td colspan="6" class="text-muted">No activity recorded.</td>
                        </tr>
                    </tbody>
                </table>

                <h5>Spare Parts</h5>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.spare_part_ids" t-as="part">
                            <td><span t-field="part.product_id"/></td>
                            <td class="text-end"><span t-field="part.quantity"/> <span t-field="part.uom_id"/></td>
                            <td class="text-end"><span t-field="part.unit_cost"/></td>
                            <td class="text-end"><span t-field="part.total_cost"/></td>
                        </tr>
                        <tr t-if="not o.spare_part_ids">
                            <td colspan="4" class="text-muted">No spare part consumed.</td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td>Labour Cost</td>
                                <td class="text-end"><span t-field="o.labour_cost"/></td>
                            </tr>
                            <tr>
                                <td>Spare Part Cost</td>
                                <td class="text-end"><span t-field="o.spare_part_cost"/></td>
                            </tr>
                            <tr class="border-top fw-bold">
                                <td>Total Maintenance Cost</td>
                                <td class="text-end"><span t-field="o.total_cost"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="o.resolution_note" class="mt-3">
                    <h5>Resolution</h5>
                    <div t-field="o.resolution_note"/>
                </div>

                <div class="row mt-5">
                    <div class="col-6">Technician signature: ______________________</div>
                    <div class="col-6">Supervisor signature: ______________________</div>
                </div>
            </div>
        </t>
    </template>

    <!-- Main template called by the report action: web.html_container provides the
         HTML page; docs = the records selected for printing -->
    <template id="report_maintenance_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="equipment_maintenance_mgmt.report_maintenance_request_document"/>
            </t>
        </t>
    </template>
</odoo>
