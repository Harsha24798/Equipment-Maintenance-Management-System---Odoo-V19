<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_maintenance_tag_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.tag.view.list</field>
        <field name="model">equipment.maintenance.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="equipment_maintenance_tag_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.tag.view.search</field>
        <field name="model">equipment.maintenance.tag</field>
        <field name="arch" type="xml">
            <search string="Search Tags">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="equipment_maintenance_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">equipment.maintenance.tag</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tag</p>
            <p>Tags classify maintenance requests (e.g. Electrical, Safety, Warranty Claim).</p>
        </field>
    </record>
</odoo>
