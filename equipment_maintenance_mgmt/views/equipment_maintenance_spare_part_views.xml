<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="equipment_maintenance_spare_part_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.spare.part.view.list</field>
        <field name="model">equipment.maintenance.spare.part</field>
        <field name="arch" type="xml">
            <list string="Spare Parts Consumption" create="0">
                <field name="request_id"/>
                <field name="equipment_id"/>
                <field name="product_id"/>
                <field name="quantity" sum="Total Quantity"/>
                <field name="uom_id" groups="uom.group_uom" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="unit_cost"/>
                <field name="total_cost" sum="Total Cost"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="equipment_maintenance_spare_part_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.spare.part.view.search</field>
        <field name="model">equipment.maintenance.spare.part</field>
        <field name="arch" type="xml">
            <search string="Search Spare Parts">
                <field name="product_id"/>
                <field name="request_id"/>
                <field name="equipment_id"/>
                <group>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="equipment_maintenance_spare_part_action" model="ir.actions.act_window">
        <field name="name">Spare Parts Consumption</field>
        <field name="res_model">equipment.maintenance.spare.part</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No spare part consumed yet</p>
            <p>Spare parts are recorded on maintenance requests.</p>
        </field>
    </record>
</odoo>
