<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration > Equipment Categories: list, form, search and action -->
    <record id="equipment_maintenance_category_view_list" model="ir.ui.view">
        <field name="name">equipment.maintenance.category.view.list</field>
        <field name="model">equipment.maintenance.category</field>
        <field name="arch" type="xml">
            <list string="Equipment Categories">
                <field name="name"/>
                <field name="code"/>
                <field name="equipment_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="equipment_maintenance_category_view_form" model="ir.ui.view">
        <field name="name">equipment.maintenance.category.view.form</field>
        <field name="model">equipment.maintenance.category</field>
        <field name="arch" type="xml">
            <form string="Equipment Category">
                <sheet>
                    <!-- Smart button: number of equipment in the category (widget statinfo) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_equipment" type="object"
                                class="oe_stat_button" icon="fa-cogs">
                            <field name="equipment_count" widget="statinfo" string="Equipment"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Machinery"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <!-- color_picker: choose the colour index with a palette -->
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="equipment_maintenance_category_view_search" model="ir.ui.view">
        <field name="name">equipment.maintenance.category.view.search</field>
        <field name="model">equipment.maintenance.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action opened by the menu; help = message displayed when there is no record -->
    <record id="equipment_maintenance_category_action" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="res_model">equipment.maintenance.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an equipment category</p>
            <p>Categories group similar equipment (machinery, IT, vehicles...) for reporting.</p>
        </field>
    </record>
</odoo>
