<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.equipment_maintenance_mgmt</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Equipment Maintenance" string="Equipment Maintenance"
                     name="equipment_maintenance_mgmt"
                     groups="equipment_maintenance_mgmt.equipment_maintenance_mgmt_group_manager">
                    <block title="Costing" name="maintenance_costing">
                        <setting string="Default Labour Rate"
                                 help="Hourly rate used when the technician has no hourly cost on their employee record.">
                            <field name="maintenance_currency_id" invisible="1"/>
                            <field name="maintenance_labour_rate"/>
                        </setting>
                    </block>
                    <block title="Warranty" name="maintenance_warranty">
                        <setting string="Warranty Alert"
                                 help="Flag equipment as 'Expiring Soon' this many days before warranty expiry.">
                            <field name="maintenance_warranty_alert_days"/> days
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_action_equipment_maintenance" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'equipment_maintenance_mgmt', 'bin_size': False}</field>
    </record>
</odoo>
