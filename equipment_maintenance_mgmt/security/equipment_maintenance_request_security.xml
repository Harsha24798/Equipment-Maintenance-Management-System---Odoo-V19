<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record rules of requests, their lines and the cost report.
         Global company rules first (AND with every other rule). -->
    <data noupdate="1">
        <record id="equipment_maintenance_request_rule_company" model="ir.rule">
            <field name="name">Maintenance Request: multi-company</field>
            <field name="model_id" ref="model_equipment_maintenance_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="equipment_maintenance_activity_rule_company" model="ir.rule">
            <field name="name">Maintenance Activity: multi-company</field>
            <field name="model_id" ref="model_equipment_maintenance_activity"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="equipment_maintenance_spare_part_rule_company" model="ir.rule">
            <field name="name">Spare Part Consumption: multi-company</field>
            <field name="model_id" ref="model_equipment_maintenance_spare_part"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="equipment_maintenance_cost_report_rule_company" model="ir.rule">
            <field name="name">Maintenance Cost Analysis: multi-company</field>
            <field name="model_id" ref="model_equipment_maintenance_cost_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <!-- USER-BASED RESTRICTION: a technician only sees the requests assigned to them
             (technician_id = user) OR reported by them (create_uid = user). '|' = OR.
             domain_force = the condition; groups = to whom the rule applies. -->
        <record id="equipment_maintenance_request_rule_technician" model="ir.rule">
            <field name="name">Maintenance Request: technician own requests</field>
            <field name="model_id" ref="model_equipment_maintenance_request"/>
            <field name="domain_force">['|', ('technician_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_technician'))]"/>
        </record>
        <!-- Lines follow the visibility of their request (request_id.technician_id ...) -->
        <record id="equipment_maintenance_activity_rule_technician" model="ir.rule">
            <field name="name">Maintenance Activity: technician own requests</field>
            <field name="model_id" ref="model_equipment_maintenance_activity"/>
            <field name="domain_force">['|', ('request_id.technician_id', '=', user.id), ('request_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_technician'))]"/>
        </record>
        <record id="equipment_maintenance_spare_part_rule_technician" model="ir.rule">
            <field name="name">Spare Part Consumption: technician own requests</field>
            <field name="model_id" ref="model_equipment_maintenance_spare_part"/>
            <field name="domain_force">['|', ('request_id.technician_id', '=', user.id), ('request_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_technician'))]"/>
        </record>
        <!-- MANAGER FULL ACCESS: [(1, '=', 1)] is always true. Rules of different groups
             are combined with OR, so this rule overrides the technician restriction. -->
        <record id="equipment_maintenance_request_rule_manager" model="ir.rule">
            <field name="name">Maintenance Request: manager all requests</field>
            <field name="model_id" ref="model_equipment_maintenance_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_manager'))]"/>
        </record>
        <record id="equipment_maintenance_activity_rule_manager" model="ir.rule">
            <field name="name">Maintenance Activity: manager all lines</field>
            <field name="model_id" ref="model_equipment_maintenance_activity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_manager'))]"/>
        </record>
        <record id="equipment_maintenance_spare_part_rule_manager" model="ir.rule">
            <field name="name">Spare Part Consumption: manager all lines</field>
            <field name="model_id" ref="model_equipment_maintenance_spare_part"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('equipment_maintenance_mgmt_group_manager'))]"/>
        </record>
    </data>
</odoo>
