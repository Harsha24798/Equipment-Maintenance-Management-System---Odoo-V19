<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_warranty_expiry_reminder" model="ir.cron">
            <field name="name">Equipment Maintenance: warranty expiry reminder</field>
            <field name="model_id" ref="model_equipment_maintenance_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_warranty_expiry_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        <record id="ir_cron_overdue_requests" model="ir.cron">
            <field name="name">Equipment Maintenance: overdue request reminder</field>
            <field name="model_id" ref="model_equipment_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_requests()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
