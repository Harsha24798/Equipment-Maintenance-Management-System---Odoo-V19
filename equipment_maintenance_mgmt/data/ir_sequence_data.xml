<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- SEQUENCE used by create() through next_by_code(code).
             prefix MR/%(year)s/ + padding 5 gives MR/2026/00001, MR/2026/00002 ...
             company_id False: one sequence shared by all companies. -->
        <record id="sequence_equipment_maintenance_request" model="ir.sequence">
            <field name="name">Maintenance Request</field>
            <field name="code">equipment.maintenance.request</field>
            <field name="prefix">MR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
